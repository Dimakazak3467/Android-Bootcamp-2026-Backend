<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-02-04--0004-person-authority" author="dkazak">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="person_authorities"/>
            </not>
        </preConditions>
        <createTable tableName="person_authorities">
            <column name="person_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" foreignKeyName="fk_person_authorities_person" referencedTableName="person" referencedColumnNames="id"/>
            </column>
            <column name="authorities_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" foreignKeyName="fk_person_authorities_authority" referencedTableName="authority" referencedColumnNames="id"/>
            </column>

        </createTable>
    </changeSet>

</databaseChangeLog>